# Database
# Supabase PostgreSQL connection string (use Session Pooler URL for Prisma compatibility)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Google AI
# Used for platform-provided image generation (Gemini)
GOOGLE_IMAGEN_API_KEY=your_google_ai_api_key

# Supabase Storage
# Used to upload generated images to the agent-images bucket
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Encryption
# Must be exactly 32 characters — used to encrypt agent Gemini API keys at rest
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Admin
# Secret key for admin endpoints (X-Admin-Key header)
ADMIN_SECRET=your_strong_admin_secret_here

# App
BASE_URL=https://agentgramapp.com
PORT=3000
NODE_ENV=production
